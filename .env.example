# ==============================================================================
# BG TOOL (bg.tools) — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# Canonical site URL used for OpenGraph, Twitter Cards, JSON-LD schemas, and Sitemap
SITE_URL=https://bg.tools

# Application environment ('production' enforces strict admin secrets, HTTPS cookies, HSTS)
NODE_ENV=production

# Server network binding
PORT=3000
HOST=127.0.0.1

# Reverse Proxy Trust (Set to 'true' ONLY behind trusted Nginx/Cloudflare reverse proxies)
# When false, X-Forwarded-For is ignored to prevent client IP spoofing in rate limits
TRUST_PROXY=false

# SQLite Database file location (WAL mode enabled automatically)
DATABASE_PATH=./data/bgtool.db

# ------------------------------------------------------------------------------
# 2. ADMINISTRATOR AUTHENTICATION (admin.bg.tools & /api/admin/*)
# ------------------------------------------------------------------------------
# Administrator email/username
ADMIN_USERNAME=admin@bg.tools

# Master admin password (MUST be >= 16 characters in production)
ADMIN_PASSWORD=replace_with_strong_random_admin_password_min_16_chars

# 32+ character cryptographic secret for signing admin session tokens & cookies
ADMIN_SESSION_SECRET=replace_with_random_32_character_admin_session_secret_min_32_chars

# ------------------------------------------------------------------------------
# 3. END-USER SESSIONS & GUEST TRACKING
# ------------------------------------------------------------------------------
# 32+ character cryptographic secret for signing user auth session cookies
SESSION_SECRET=replace_with_random_32_character_user_session_secret_min_32_chars

# 32+ character cryptographic secret for signing guest rate-limit & credit cookies
GUEST_COOKIE_SECRET=replace_with_random_32_character_guest_cookie_secret_min_32_chars

# ------------------------------------------------------------------------------
# 4. KARUDI AI — SELF-HOSTED MODEL ON HOSTINGER VPS
# ------------------------------------------------------------------------------
# Connect to your private model running on Hostinger VPS (via Ollama or vLLM):
AI_PROVIDER=custom
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:7b-instruct-q4_K_M
# Optional auth token if configured on your VPS reverse proxy (Nginx):
# AI_API_KEY=your_optional_vps_token

# Python Environment (Optional path to python executable for AI microservices):
# PYTHON_PATH=python

# ------------------------------------------------------------------------------
# 5. SECURITY, PRIVACY & UPLOAD CONTROLS
# ------------------------------------------------------------------------------
# Maximum size in bytes per uploaded file (Default: 31457280 = 30 MB)
MAX_FILE_SIZE_BYTES=31457280

# Maximum request body size in bytes (Default: 62914560 = 60 MB)
MAX_REQUEST_SIZE_BYTES=62914560

# Maximum batch upload files per request (Default: 10)
MAX_BATCH_FILES=10

# Maximum image dimensions & pixel count for decompression bomb protection
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_HEIGHT=6000
MAX_IMAGE_PIXELS=36000000

# ------------------------------------------------------------------------------
# 6. CLUSTER-COORDINATED RATE LIMITS (Requests per minute per client IP)
# ------------------------------------------------------------------------------
RATE_LIMIT_GENERAL=60
RATE_LIMIT_UPLOADS=15
RATE_LIMIT_EXPENSIVE=6
RATE_LIMIT_CONTACT=5
RATE_LIMIT_AUTH=10
